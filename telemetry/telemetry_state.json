#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <sys/stat.h>
#include <sys/inotify.h>

#define CONF_FILE "sluice-bench/collector/collector.conf"
#define JSON_FILE "telemetry/telemetry_state.json"
#define EVENT_SIZE (sizeof(struct inotify_event))
#define BUF_LEN (1024 * (EVENT_SIZE + 16))

// Clear structured matrix layout
typedef struct {
    int routing_channel;
    char target_ingress[64];
    char log_level[64];
    int thread_lock;
} TelemetryEnv;

// Safe configuration string value extractor
void get_conf_value(const char *line, const char *key, char *output) {
    const char *ptr = strchr(line, '=');
    if (ptr) {
        strcpy(output, ptr + 1);
        size_t len = strlen(output);
        while (len > 0 && (output[len-1] == '\n' || output[len-1] == '\r' || output[len-1] == ' ')) {
            output[len-1] = '\0';
            len--;
        }
    }
}

// Fixed system environment configuration parser
int parse_system_environment(TelemetryEnv *env) {
    FILE *fp = fopen(CONF_FILE, "r");
    if (!fp) return 0;

    char line[256];
    env->routing_channel = 1;
    strcpy(env->target_ingress, "UNKNOWN");
    strcpy(env->log_level, "DISABLED");
    env->thread_lock = 0;

    while (fgets(line, sizeof(line), fp)) {
        if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;

        char temp[64] = {0};
        if (strstr(line, "DATA_ROUTING_CHANNEL=")) {
            get_conf_value(line, "DATA_ROUTING_CHANNEL", temp);
            env->routing_channel = atoi(temp);
        } else if (strstr(line, "TARGET_INGRESS=")) {
            get_conf_value(line, "TARGET_INGRESS", env->target_ingress);
        } else if (strstr(line, "FILTRATION_LOG_LEVEL=")) {
            get_conf_value(line, "FILTRATION_LOG_LEVEL", env->log_level);
        } else if (strstr(line, "THREAD_LOCK_GATE=")) {
            get_conf_value(line, "THREAD_LOCK_GATE", temp);
            env->thread_lock = (strcmp(temp, "TRUE") == 0 || strcmp(temp, "TRUE\r") == 0) ? 1 : 0;
        }
    }
    fclose(fp);
    return 1;
}

// Real-time local JSON file metrics reader
void process_telemetry_payload() {
    FILE *json = fopen(JSON_FILE, "r");
    if (!json) return;

    char line[256];
    int v = 0, f = 0;
    double g = 0.0;
    
    while (fgets(line, sizeof(line), json)) {
        const char *colon = strchr(line, ':');
        if (!colon) continue;
        
        if (strstr(line, "\"voip_ingress_kbps\"")) v = atoi(colon + 1);
        if (strstr(line, "\"filtration_drop_rate\"")) f = atoi(colon + 1);
        if (strstr(line, "\"financial_gain_usd\"")) g = atof(colon + 1);
    }
    fclose(json);

    time_t raw_time;
    time(&raw_time);
    struct tm *info = localtime(&raw_time);
    
    printf("[%02d:%02d:%02d] \033[1;32m[TELEMETRY EVENT-SYNC]\033[0m VoIP: %d kbps | Drop: %d%% | Yield: $%.2f USD\n", 
           info->tm_hour, info->tm_min, info->tm_sec, v, f, g);
}

int main() {
    TelemetryEnv sys_env;
    int length, i = 0;
    int fd, wd;
    char buffer[BUF_LEN];

    printf("\n\033[1;36m[MARDUKH INOTIFY KERNEL ENGINE ONLINE]\033[0m\n");
    printf("[BOOT] Loading criteria matrices from system configurations...\n");

    if (!parse_system_environment(&sys_env)) {
        printf("\033[1;31m[ERROR] Configuration layout file missing: %s\033[0m\n", CONF_FILE);
        return 1;
    }

    printf("[STATE] Routing Link Channel: %d\n", sys_env.routing_channel);
    printf("[STATE] Stream Node Affinity: %s\n", sys_env.target_ingress);
    printf("[STATE] Engine Thread Locking: %s\n\n", sys_env.thread_lock ? "ENABLED" : "DISABLED");

    fd = inotify_init();
    if (fd < 0) return 1;

    wd = inotify_add_watch(fd, "telemetry", IN_MODIFY | IN_CLOSE_WRITE);
    if (wd < 0) {
        printf("\033[1;31m[ERROR] Cannot monitor directory path targets. Ensure folder exists.\033[0m\n");
        close(fd);
        return 1;
    }

    printf("\033[1;32m[KERNEL INTERCEPT] Thread asleep. Awaiting hardware event interrupts...\033[0m\n\n");
    process_telemetry_payload();

    while (1) {
        i = 0;
        length = read(fd, buffer, BUF_LEN);
        if (length < 0) break;

        while (i < length) {
            struct inotify_event *event = (struct inotify_event *)&buffer[i];
            if (event->len && strcmp(event->name, "telemetry_state.json") == 0) {
                process_telemetry_payload();
            }
            i += EVENT_SIZE + event->len;
        }
    }

    inotify_rm_watch(fd, wd);
    close(fd);
    return 0;
}
