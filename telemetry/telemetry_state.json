#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>
#include <sys/stat.h>

#define CONF_FILE "sluice-bench/collector/collector.conf"
#define JSON_FILE "telemetry/telemetry_state.json"

// Structure to parse and hold active telemetry configuration fields
typedef struct {
    int routing_channel;
    char target_ingress[64];
    char log_level[32];
    int thread_lock;
} TelemetryEnv;

// Helper function to extract a clean string value from collector.conf keys
void get_conf_value(const char *line, const char *key, char *output) {
    char match[128];
    sprintf(match, "%s=%%s", key);
    if (sscanf(line, match, output) == 1) {
        // Strip trailing windows carriage returns if present on mobile layout blocks
        size_t len = strlen(output);
        if (len > 0 && output[len-1] == '\r') output[len-1] = '\0';
    }
}

// System profile configuration loader
int parse_system_environment(TelemetryEnv *env) {
    FILE *fp = fopen(CONF_FILE, "r");
    if (!fp) return 0;

    char line[256];
    // Default fallback initializations
    env->routing_channel = 1;
    strcpy(env->target_ingress, "UNKNOWN");
    strcpy(env->log_level, "DISABLED");
    env->thread_lock = 0;

    while (fgets(line, sizeof(line), fp)) {
        if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;

        char temp[128] = {0};
        if (strstr(line, "DATA_ROUTING_CHANNEL=")) {
            get_conf_value(line, "DATA_ROUTING_CHANNEL", temp);
            env->routing_channel = atoi(temp);
        } else if (strstr(line, "TARGET_INGRESS=")) {
            get_conf_value(line, "TARGET_INGRESS", env->target_ingress);
        } else if (strstr(line, "FILTRATION_LOG_LEVEL=")) {
            get_conf_value(line, "FILTRATION_LOG_LEVEL", env->log_level);
        } else if (strstr(line, "THREAD_LOCK_GATE=")) {
            get_conf_value(line, "THREAD_LOCK_GATE", temp);
            env->thread_lock = (strcmp(temp, "TRUE") == 0) ? 1 : 0;
        }
    }
    fclose(fp);
    return 1;
}

int main() {
    TelemetryEnv sys_env;
    struct stat filestat;
    
    printf("\n\033[1;36m[MARDUKH TELEMETRY SUB-CORE INITIALIZED]\033[0m\n");
    printf("[BOOT] Loading path criteria matrices from system configurations...\n");

    // Pull environmental tracking metrics from collector setup
    if (!parse_system_environment(&sys_env)) {
        printf("\033[1;31m[ERROR] Structural criteria file path missing: %s\033[0m\n", CONF_FILE);
        return 1;
    }

    printf("[STATE] Routing Link Channel: %d\n", sys_env.routing_channel);
    printf("[STATE] Stream Node Affinity: %s\n", sys_env.target_ingress);
    printf("[STATE] Verification Filter : %s\n", sys_env.log_level);
    printf("[STATE] Engine Thread Locking: %s\n\n", sys_env.thread_lock ? "ENABLED" : "DISABLED");

    printf("\033[1;32m[MONITOR] Listening continuously on directory tracking changes...\033[0m\n");

    int last_voip = 0;
    int last_filt = 0;
    double last_gain = 0.0;
    time_t last_mod_time = 0;

    while (1) {
        // Read file status headers to evaluate processing interval ticks
        if (stat(JSON_FILE, &filestat) == 0) {
            // Only process updates if the telemetry file has been physically modified on disk
            if (filestat.st_mtime != last_mod_time) {
                last_mod_time = filestat.st_mtime;
                
                FILE *json = fopen(JSON_FILE, "r");
                if (json) {
                    char line[256];
                    int v = 0, f = 0;
                    double g = 0.0;
                    
                    // Parse live metrics parameters straight out of json array formatting
                    while (fgets(line, sizeof(line), json)) {
                        if (strstr(line, "\"voip_ingress_kbps\"")) sscanf(line, "%*[^:] : %d", &v);
                        if (strstr(line, "\"filtration_drop_rate\"")) sscanf(line, "%*[^:] : %d", &f);
                        if (strstr(line, "\"financial_gain_usd\"")) sscanf(line, "%*[^:] : %lf", &g);
                    }
                    fclose(json);

                    // Output clean formatted updates if values shifted
                    if (v != last_voip || f != last_filt || g != last_gain) {
                        last_voip = v;
                        last_filt = f;
                        last_gain = g;

                        time_t raw_time;
                        time(&raw_time);
                        struct tm *info = localtime(&raw_time);
                        
                        printf("[%02d:%02d:%02d] \033[1;33m[TELEMETRY SYNC]\033[0m VoIP Ingress: %d kbps | Loop Drop: %d%% | Yield Matrix: $%.2f USD\n", 
                               info->tm_hour, info->tm_min, info->tm_sec, last_voip, last_filt, last_gain);
                    }
                }
            }
        } else {
            // Fail-silent logging monitor notice if data loop has not written file frames yet
            printf("[WARNING] Waiting for local data collection payload frame at target: %s\n", JSON_FILE);
            sleep(3);
        }
        
        usleep(500000); // 500ms continuous filesystem state checking polling frequency parameters
    }
    return 0;
}
